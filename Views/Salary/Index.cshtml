@model IEnumerable<EmployeeManager.Models.SalaryInfo>
@{
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var currentDept = ViewBag.CurrentDepartment as string;
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Empoyee Salary</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">Add Salary</a>
           
        </div>
    </div>

    <form asp-action="Index" method="get" class="form-inline mb-3">
        <select name="department" class="form-control mr-2">
            <option value="">All Departments</option>
            @foreach (var dept in departments)
            {
                <option value="@dept" selected="@(dept == currentDept)">@dept</option>
            }
        </select>

        <input type="text"
               name="search"
               value="@currentSearch"
               placeholder="Search name or email..."
               class="form-control mr-2" />

        <button type="submit" class="btn btn-secondary mr-2">Filter</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Job Grade</th>
                <th>Salary</th>
                <th>Hire Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Department</td>
                <td>@item.JobGrade </td>
                <td>@item.NetPay.ToString("C")</td>
                <td>@item.HireDate.ToShortDateString()</td>
               

                <td>
                    <form asp-action="ExportPdf" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-info">Print Slip</button>
                    </form>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
