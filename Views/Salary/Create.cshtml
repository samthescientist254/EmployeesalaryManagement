@model EmployeeManager.Models.SalaryInfo

<div class="container mt-4">
    <h2>Add Salary</h2>
    <form asp-action="Create" method="post" class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="FullName"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
         <select name="Department" class="form-control mr-2" >
            <option value="">Select Department</option>
             <option value="Tech">Tech</option>
             <option value="Sales">Sales</option>
             <option value="Business"> Business</option>
        </select>
               </div>
       
         <div class="form-group mb-3">
         <select name="JobGrade" class="form-control mr-2" id="categorySelect">
            <option value="">Select Job Grade</option>
             <option value="A">A</option>
             <option value="B">B</option>
             <option value="C">C</option>
        </select>
               </div>
          <div class="form-group mb-3">
         <select name="TaxModelType" class="form-control mr-2">
            <option value="">Select Tax Model</option>
             <option value="1">Hourly Rate</option>
             <option value="2">Distributed Rates</option>
        </select>
               </div>
        <div class="form-group mb-3">
            <label asp-for="rate"></label>
            <input asp-for="rate"  class="form-control" type="number"  id="srate" step="0.01" readonly/>
        </div>
        <div class="form-group mb-3">
            <label asp-for="hours"></label>
            <input asp-for="hours" class="form-control" type="number" step="0.01" />
        </div>
        <div class="form-group mb-3">
            <label asp-for="HireDate"></label>
            <input asp-for="HireDate" class="form-control" type="date" />
        </div>
        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section Scripts {
    <!-- Required for ASP.NET Core client-side validation -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selectElement = document.getElementById("categorySelect");
            const inputElement = document.getElementById("srate");

            selectElement.addEventListener("change", function () {
                const selectedValue = this.value;
        console.log("value:"+selectedValue);
              if(selectedValue == "A"){
          inputElement.value = 300;
        }else if(selectedValue  == "B"){
        inputElement.value = 500;
        }
        else{
        inputElement.value = 1000;
        }
              

                // 2. Trigger validation on BOTH the select and the updated input
                // Using jQuery Validation ($().valid()) forces the UI error spans to update immediately
                $(selectElement).valid();
                $(inputElement).valid();
            });
        });
    </script>
}
